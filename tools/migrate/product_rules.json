{
  "_説明": "備考から生産品種を振り分ける規則（docs/04 第1部 §13.3、K-16）。備考を NFKC で正規化したあと、rules を上から順に当てはめ、最初に当てはまった品種にする。どれにも当てはまらなければ空。byPattern は「その規則に当てはまり、パターンがこの番号なら、こちらの品種にする」。blankByPattern は「品種が空で、パターンがこの番号なら、この品種にする」（2026/11/15 の依頼: パターン3は2L麦茶の設定のため）。products は品種マスタの初期データ（D-20。2026/11/15 に8つへ集約）",
  "products": ["小型(0.35〜1.0L)", "小型(水、スポーツ)", "1.5L(お茶)", "1.5L(水、スポーツ)", "2L(麦茶あり)", "2L(麦茶なし)", "2L(水、スポーツ)", "その他"],
  "blankByPattern": { "3": "2L(麦茶あり)" },
  "rules": [
    { "pattern": "麦茶\\s*(なし|無し|無)", "product": "2L(麦茶なし)" },
    { "pattern": "麦茶", "product": "2L(麦茶あり)" },
    { "pattern": "2L\\s*\\(?\\s*(水|スポーツ)", "product": "2L(水、スポーツ)" },
    { "pattern": "2L", "product": "2L(麦茶なし)", "byPattern": { "3": "2L(麦茶あり)" } },
    { "pattern": "1\\.5L\\s*\\(?\\s*(水|スポーツ)", "product": "1.5L(水、スポーツ)" },
    { "pattern": "1\\.5L", "product": "1.5L(お茶)" },
    { "pattern": "0\\.525|0\\.55|550\\s*ml", "product": "小型(水、スポーツ)" },
    { "pattern": "0\\.(35|5|6)\\s*(k|m|L)?\\s*\\(?\\s*(水|スポーツ)", "product": "小型(水、スポーツ)" },
    { "pattern": "0\\.5\\s*(k|m|L|生産)", "product": "小型(0.35〜1.0L)" },
    { "pattern": "0\\.6\\s*(k|m|L)", "product": "小型(0.35〜1.0L)" },
    { "pattern": "0\\.35", "product": "小型(0.35〜1.0L)" },
    { "pattern": "小型|(^|[^.\\d])1(\\.0)?L", "product": "小型(0.35〜1.0L)" }
  ]
}
